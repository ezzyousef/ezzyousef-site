# Password for the admin dashboard, stored as a bcrypt hash.
# Generate with:  npm run hash -- "your-password-here"
ADMIN_PASSWORD_HASH=

# Long random string used to sign login tokens.
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Created automatically when you add Blob storage to the project in Vercel.
BLOB_READ_WRITE_TOKEN=

# Optional. Vercel Project Settings, Git, Deploy Hooks. Saving in the
# dashboard then asks for a rebuild so the baked-in content stays current.
DEPLOY_HOOK_URL=
